   "schema:description": {
    "@language": "en",
    "@value": "Paolo Moressoni: architect; collaborator on 'Pump It Up House' (2007) with the design team Baires Raffaelli, Elio Rava and Tommaso Passalacqua, and consultant/collaborator on the 2007 small railway stations competition entry; member of the council of the Ordine degli Architetti of Perugia and speaker at the 6 October 2021 webinar 'La citta' di ognuno' (per the event poster). Not Baires Raffaelli."
   },
   "schema:disambiguatingDescription": {
