:ev01 a brv:CitationEvidence ;
    schema:description "Gelfond (AHTI 2020) attributes the 'open and closed folds' shaping techniques to Raffaelli and cites The Fast Guide to Architectural Form (BIS, 2016), p. 49, in footnote [14]."@en ;
    schema:inLanguage "en" ;
    brv:citedWork :work-form ;
    brv:citingWork :cite-gelfond-ahti-2020 ;
    brv:evidenceFile "125944750 (1).pdf" ;
    brv:evidenceKind "scholarly-citation" ;
    brv:pinpoint "PDF p. 5-6" .

:ev02 a brv:CitationEvidence ;
    schema:description "Russian-language article by Gelfond lists The Fast Guide to Architectural Form, translated by Silvia Antonini, as reference no. 13 (Figs. 17-18 on arch-building typology)."@en ;
    schema:inLanguage "ru" ;
    brv:citedWork :work-form ;
    brv:citingWork :cite-gelfond-raasn-2020 ;
    brv:evidenceFile "o-prostranstvennoy-tipologii-zdaniy-arok.pdf" ;
    brv:evidenceKind "scholarly-citation" ;
    brv:pinpoint "PDF p. 13-14" .

:ev03 a brv:CitationEvidence ;
    schema:description "Bibliography of a paper in volume B of the 3rd Panhellenic Conference lists Raffaelli (2016), The fast guide to architectural form, Bispublishers."@en ;
    schema:inLanguage "el" ;
    brv:citedWork :work-form ;
    brv:citingWork :cite-ekedisy-2018 ;
    brv:evidenceFile "3ο-Συνέδριο-Β-τόμος1.pdf" ;
    brv:evidenceKind "bibliography-entry" ;
    brv:pinpoint "PDF p. 178" .

:ev04 a brv:CitationEvidence ;
    schema:description "Romanian curriculum for Atelier de specialitate (grades IX-XII) lists The Fast Guide to Architectural Form (BIS Publishers, dated 2023 in the source) as recommended reading under 'Arte ambientale'; name appears in both orders (Baires, Raffaelli / Raffaelli Baires)."@en ;
    schema:inLanguage "ro" ;
    brv:citedWork :work-form ;
    brv:citingWork :course-romania-atelier-2025 ;
    brv:evidenceFile "Arhitectura_Atelier_specialitate_CS_IX_XII.pdf" ;
    brv:evidenceKind "course-adoption" ;
    brv:pinpoint "PDF p. 25-26" .

:ev05 a brv:CitationEvidence ;
    schema:description "ACSA award statement (D. Buntrock) lists the Form book, pp. 16-17, in a student's ('Amy' Hay Mew Hwang, UC Berkeley) reference list."@en ;
    schema:inLanguage "en" ;
    brv:citedWork :work-form ;
    brv:citingWork :cite-buntrock-acsa-2017 ;
    brv:evidenceFile "DP-Buntrock-opt.pdf" ;
    brv:evidenceKind "bibliography-entry" ;
    brv:pinpoint "PDF p. 13" .

:ev06 a brv:CitationEvidence ;
    schema:description "Doctoral thesis by M. Aflalo (USP) lists the Form book (BIS, 2016) with the author's surname misspelled 'RAFAELLI'."@en ;
    schema:inLanguage "pt" ;
    brv:citedWork :work-form ;
