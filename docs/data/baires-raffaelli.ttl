    brv:evidenceKind "bibliography-entry" ;
    brv:pinpoint "PDF p. 137" .

:ev07 a brv:CitationEvidence ;
    schema:description "ENSA Clermont-Ferrand student guide 2022-23 lists the Form book (BIS, 2016) in the commented basic bibliography of four courses (pp. 78, 112, 146, 184)."@en ;
    schema:inLanguage "fr" ;
