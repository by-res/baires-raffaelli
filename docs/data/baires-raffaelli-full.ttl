    rdfs:domain schema:Thing .

brv:deprecatedUrl a rdf:Property ;
    rdfs:label "deprecated URL"@en ;
    rdfs:comment "URL that is broken or not pertinent (kept as a string, not as a link, so that it is not followed)."@en ;
    rdfs:domain schema:Thing .

brv:evidenceFile a rdf:Property ;
    rdfs:label "evidence file name"@en ;
    rdfs:domain brv:CitationEvidence .

brv:evidenceKind a rdf:Property ;
    rdfs:label "evidence kind"@en ;
