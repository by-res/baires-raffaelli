:project-bettona-cq3 a bf:Work,
        schema:CreativeWork ;
    bf:contribution [ a bf:Contribution ;
            bf:agent :baires-raffaelli ;
            bf:role [ a bf:Role ;
                    rdfs:label "author" ] ],
        [ a bf:Contribution ;
            bf:agent :angela-buompadre ;
            bf:role [ a bf:Role ;
                    rdfs:label "author (incarico: redazione del Programma)" ] ],
        [ a bf:Contribution ;
            bf:agent :paolo-luccioni ;
            bf:role [ a bf:Role ;
                    rdfs:label "collaborator" ] ],
        [ a bf:Contribution ;
            bf:agent :archstudio-luccioni ;
            bf:role [ a bf:Role ;
                    rdfs:label "collaborator" ] ] ;
    schema:alternateName "Neighborhood Contract 3, Bettona historic centre"@en ;
    schema:author :angela-buompadre,
        :baires-raffaelli ;
    schema:contentLocation [ a schema:Place ;
            schema:name "Bettona (PG)" ] ;
    schema:contributor :archstudio-luccioni,
        :paolo-luccioni ;
    schema:dateCreated "2009"^^xsd:gYear ;
    schema:description "Contratto di Quartiere III of Bettona (PG), 2009: urban regeneration programme for the historic centre submitted by the Comune di Bettona to the Umbria Region; programme drafted by Angela Buompadre, with Baires Raffaelli as the commissioned designer (former elementary school and Via S. Giacomo) and Paolo Luccioni with his studio Luccioni Archstudio as collaborators."@en ;
    schema:name "Contratto di Quartiere III - Bettona Centro Storico (Programma di riqualificazione urbana per alloggi a canone sostenibile)"@it ;
    schema:sponsor :comune-bettona ;
    schema:url <https://www.baires.eu/album/transformative-urban-revitalization-bettona-pg/> ;
    brv:dataQualityNote "Fonte: cartella di lavoro dello studio Luccioni Archstudio (0109 - CQ3 Bettona Centro Storico), copia fornita dall'autore. Candidatura del Comune di Bettona al bando regionale (DGR Umbria 14/07/2008 n. 883, contributo massimo 1.500.000 EUR): assemblee pubbliche 19 e 26 febbraio 2009, elaborati trasmessi al Sindaco il 27/02/2009 (lettera di Luccioni Archstudio, Prot. 011/09). Disciplinare di incarico del Comune per la redazione del Programma intestato all'arch. Angela Buompadre; interventi: ex scuola elementare di Viale Roma (edilizia residenziale a canone sociale e uffici), auditorium nella ex Chiesa di S. Caterina, riqualificazione di Via S. Giacomo, piano attuativo privato del comparto Co E/04 (Impresa Bellavista Costruzioni). Costo totale dichiarato: 3.162.368,25 EUR. Esito del finanziamento non documentato nella cartella. Ruolo confermato dall'autore (27/10/2026): incarico di Baires Raffaelli; Paolo Luccioni e il suo studio Luccioni Archstudio collaboratori (la cartella proviene dall'archivio dello studio, che ha curato anche l'invio degli elaborati al Comune, Prot. 011/09)."@it ;
    brv:verificationBasis "author-supplied-document" ;
    brv:verificationStatus "verified-secondary" .

