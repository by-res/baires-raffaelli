    schema:contentLocation [ a schema:Place ;
            schema:containedInPlace [ a schema:AdministrativeArea ;
                    schema:name "Perugia (PG), Umbria, Italy" ] ;
            schema:name "Foligno" ] ;
    schema:dateCreated "2006"^^xsd:gYear ;
    schema:description "Accessible home in via Pascoli, Foligno (2006), designed by Baires Raffaelli (sole author, per the author's statement of 25/10/2026); Tosi & Pistolesi (2022, printed p. 58-59, Fig. 4.3) state it was designed by the architect Baires Raffaelli and present its floor plan (source: Arch. Baires Raffaelli, 2006) as an example of accessible home design."@en ;
    schema:genre "residential architecture; accessible housing"@en ;
    schema:name "Casa in via Pascoli, Foligno (PG)"@it ;
    schema:subjectOf :cerpa-casa-foligno-2016,
        :cite-tosi-pistolesi-2022 ;
    brv:dataQualityNote "AUTORE: Baires Raffaelli e' l'unico autore del progetto (dichiarazione dell'autore, 25/10/2026); concorda Tosi & Pistolesi 2022, PDF pp. 59-60 (progetto dell'architetto Baires Raffaelli, 2006). Il testo di Tosi & Pistolesi (p. 58 stampata, PDF p. 59) dice 'La casa in via Pascoli a Foligno (PG) (2006), progettata dall'architetto Baires Raffaelli' e la Fig. 4.3 (pianta) ha come fonte 'Arch. Baires Raffaelli, 2006'; la nota 8 cita come fonte l'articolo Superabile 'La casa in via Pascoli' (URL oggi reindirizzato alla home, conservato come brv:deprecatedUrl). La pagina CERPA (04/02/2016) riprende un articolo di Superabile sulla casa di Foligno: la descrive come esito di un lavoro partecipato in piu' fasi, con Baires intervenuto nella piu' recente ristrutturazione della zona notte; non cita via ne' anno, ma per titolo e fonte coincide con la nota 8. Abitazione al piano terra di una palazzina plurifamiliare, 115 mq con giardino di 90 mq (Tosi). Per riservatezza il dataset non registra residenti, rapporti di parentela ne' numero civico."@it ;
    brv:deprecatedUrl "https://www.superabile.it/cs/superabile/accessibilita-colore-e-creativita-la-casa-in-via-pascoli-a-f.html" ;
    brv:sourceRecord "07.08" ;
    brv:verificationBasis "author-supplied-document" ;
    brv:verificationNote "Design credit confirmed by the author and by a published paper (Tosi & Pistolesi) supplied by the author"@en ;
    brv:verificationStatus "verified-secondary" .

